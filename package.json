{
  "name": "sunway-myevents",
  "version": "1.0.0",
  "description": "Event Management and Recommendation System for Sunway Campus",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/server\" \"npm run dev --workspace=apps/client\"",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:client": "npm run dev --workspace=apps/client",
    "build": "npm run build --workspace=apps/client && npm run build --workspace=apps/server",
    "start": "npm run start --workspace=apps/server",
    "test": "npm test --workspace=apps/server"
  },
  "keywords": [],
  "author": "Tiong Jia Yi",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
